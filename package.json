{
  "name": "spooky",
  "version": "0.1.0",
  "private": true,
  "description": "A pixel ghost that haunts your desktop. A local open-weight model decides its mischief.",
  "main": "./out/main/index.js",
  "author": "Dusuna",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run build:native && npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac --dir && npm run sign:adhoc",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:native": "node scripts/build-native.mjs",
    "sign:adhoc": "node scripts/sign-mac.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
